# Deny by default. Re-include only inputs needed by the frontend and Go builds.
**

!go.mod
!go.sum
!go.work
!go.work.sum

!api/
!api/**/
!api/go.mod
!api/go.sum
!api/**/*.go
!api/openapiv2/gen/phlare.swagger.json

!cmd/
!cmd/**/
!cmd/**/*.go
!cmd/profilecli/static/**

!lidia/
!lidia/**/
!lidia/go.mod
!lidia/go.sum
!lidia/**/*.go

!pkg/
!pkg/**/
!pkg/**/*.go
!pkg/**/*.gohtml
!pkg/api/static/**

!ui/
!ui/package.json
!ui/yarn.lock
!ui/.yarnrc.yml
!ui/.npmrc
!ui/index.html
!ui/vite.config.ts
!ui/tsconfig*.json
!ui/*.go
!ui/src/
!ui/src/**
!ui/public/
!ui/public/**

!tools/
!tools/clickhouse-object-store/
!tools/clickhouse-object-store/pyroscope.yaml

# Keep local state, generated output, and credentials out even if a future
# allowlist rule broadens the context.
.git
.git/**
.tmp
.tmp/**
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/coverage
**/coverage/**
**/testdata
**/testdata/**
**/*_test.go
**/*.out
**/*.prof
**/.env
**/.env.*
**/*credential*
**/*secret*
**/*.crt
**/*.key
**/*.p12
**/*.pem
